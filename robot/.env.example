# TERRAIN-X · robótica · configuración local
# Copie este archivo a .env (que está en .gitignore) y rellene SOLO lo que conozca.
# No invente valores: si un dato se desconoce, déjelo vacío o en "unknown".

# Identificador interno que damos nosotros al robot (etiqueta, no un dato de fábrica)
TERRAINX_ROBOT_ID=go2-terrestre-01

# Modelo y firmware DECLARADOS por el operador (p. ej. leídos en la app oficial).
# La conexión WebRTC no los informa: si se dejan vacíos, constan como "unknown".
TERRAINX_GO2_MODEL=unknown          # AIR | PRO | EDU | unknown
TERRAINX_GO2_FIRMWARE=              # p. ej. 1.1.7 ; vacío = desconocido

# Conexión local. El modo Remote (nube de Unitree) está DESHABILITADO por política.
TERRAINX_GO2_METHOD=LocalSTA        # LocalAP | LocalSTA
TERRAINX_GO2_IP=                    # IP del robot en la red local (LocalSTA)
TERRAINX_GO2_SERIAL=                # alternativa a la IP: descubrimiento multicast

# Clave AES-128 por dispositivo (solo firmware Go2 >= 1.1.15, según la librería).
# Debe estar en un archivo FUERA del repositorio. El programa rechaza rutas internas.
# NUNCA escriba la clave en este archivo.
TERRAINX_GO2_AES_KEY_FILE=

TERRAINX_GO2_CONNECT_TIMEOUT_S=30
# Activar el flujo LiDAR al conectar (rt/utlidar/switch = "on"); no es una orden de movimiento.
TERRAINX_GO2_ENABLE_LIDAR=true

# Carpeta de datos generados (relativa a robot/). Está en .gitignore.
TERRAINX_DATA_DIR=runtime
